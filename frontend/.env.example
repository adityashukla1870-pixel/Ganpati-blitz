# ==========================================
# Ganpati Blitz - Frontend Environment Variables
# ==========================================

# Backend API URL (without trailing slash)
# Points to your deployed Render web service (e.g. https://ganpati-blitz-backend.onrender.com)
VITE_API_URL=https://ganpati-blitz-backend.onrender.com

# Backend Socket.IO URL (without trailing slash)
# Usually identical to VITE_API_URL unless running on a distinct subdomain
VITE_SOCKET_URL=https://ganpati-blitz-backend.onrender.com
