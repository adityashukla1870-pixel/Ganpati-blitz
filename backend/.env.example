# ==========================================
# Ganpati Blitz - Backend Environment Variables
# ==========================================

# Server Environment (production or development)
FLASK_ENV=production

# Flask Secret Key for session integrity
# In production, set to a strong random 32+ character string or leave empty to auto-generate
SECRET_KEY=your-secure-random-secret-key-min-32-chars

# Port (Render sets this dynamically via $PORT)
PORT=5000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/ganpati_blitz?retryWrites=true&w=majority

# Allowed Frontend Origins for CORS & Socket.IO (comma-separated, without trailing slashes)
# Example: https://ganpati-blitz.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Primary Frontend URL (alternative/convenience single origin)
FRONTEND_URL=https://your-frontend.vercel.app

# Socket.IO Async Mode (threading, eventlet, or gevent)
# Default is threading with simple-websocket
SOCKETIO_ASYNC_MODE=threading
